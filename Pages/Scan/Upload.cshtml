@page
@model IngredientIQ.Pages.Scan.UploadModel
@{
    ViewData["Title"] = "Scan a Product";
    ViewData["ScanStep"] = 1;
}

<partial name="_ScanSteps" />

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-4">🔍 Scan a Product</h2>

        @if (User.Identity?.IsAuthenticated != true)
        {
            var used = ViewContext.HttpContext.Session.GetInt32("GuestScans") ?? 0;
            var remaining = 3 - used;
            <div class="alert @(remaining <= 1 ? "alert-warning" : "alert-info") py-2">
                @if (remaining > 0)
                {
                    <span>🎟️ <strong>@remaining</strong> free scan@(remaining == 1 ? "" : "s") remaining. <a asp-page="/Account/Register">Register</a> for unlimited.</span>
                }
                else
                {
                    <span>🚫 You've used all 3 free scans. <a asp-page="/Account/Register" class="alert-link">Register</a> to continue.</span>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post" enctype="multipart/form-data">
            <div class="card mb-4">
                <div class="card-header">📷 Upload Label Image</div>
                <div class="card-body">
                    <input asp-for="ImageFile" class="form-control" accept="image/jpeg,image/png,image/webp,image/heic"
                           id="imageInput" />
                    <small class="text-muted">JPG, PNG, WEBP, or HEIC — max 10 MB</small>
                    <div id="imagePreview" class="mt-3" style="display:none;">
                        <img id="previewImg" class="img-fluid rounded" style="max-height:300px;" alt="Preview" />
                    </div>
                    <div class="mt-2">
                        <small class="text-muted">
                            💡 Tips: Position label clearly • Ensure good lighting • Keep parallel to camera
                        </small>
                    </div>
                </div>
            </div>

            <div class="text-center text-muted mb-3">— OR —</div>

            <div class="card mb-4">
                <div class="card-header">✏️ Enter Ingredients Manually</div>
                <div class="card-body">
                    <textarea asp-for="ManualText" class="form-control" rows="5"
                              placeholder="Paste or type ingredients here, separated by commas..."></textarea>
                </div>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100">
                Analyze Ingredients →
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/scan.js" asp-append-version="true"></script>
}
